---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

// Imported here (not via CSS @import) so Vite rebases KaTeX's relative font URLs
// correctly and bundles the woff2 files locally — no CDN, and only on post pages.
import 'katex/dist/katex.min.css';

import TableOfContents from '../components/TableOfContents.astro';
import type { Lang } from '../config';
import { formatDate, localePath, useTranslations } from '../i18n/utils';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  lang: Lang;
  alternateHref?: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { entry, headings, lang, alternateHref, prev, next } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, tags } = entry.data;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternateHref={alternateHref}
  ogType="article"
>
  <article>
    <header class="mb-8 border-b border-line pb-6">
      <h1 class="text-3xl leading-tight font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-subtle">
        <time datetime={pubDate.toISOString()} class="tabular-nums">
          {formatDate(pubDate, lang)}
        </time>
        {
          updatedDate && (
            <span class="tabular-nums">
              {t('blog.updated')} {formatDate(updatedDate, lang)}
            </span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <li class="rounded border border-line px-1.5 py-px text-xs text-subtle">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <TableOfContents headings={headings} lang={lang} />

    <div class="prose max-w-[70ch]">
      <slot />
    </div>
  </article>

  {
    (prev || next) && (
      <nav class="mt-14 grid gap-4 border-t border-line pt-6 text-sm sm:grid-cols-2">
        {prev ? (
          <a href={prev.href} class="group flex flex-col gap-1">
            <span class="text-xs text-subtle">← {t('blog.prev')}</span>
            <span class="transition-colors group-hover:text-brand">{prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={next.href} class="group flex flex-col gap-1 sm:items-end sm:text-right">
            <span class="text-xs text-subtle">{t('blog.next')} →</span>
            <span class="transition-colors group-hover:text-brand">{next.title}</span>
          </a>
        )}
      </nav>
    )
  }

  <p class="mt-10 text-sm">
    <a href={localePath('/blog', lang)} class="text-subtle transition-colors hover:text-brand">
      ← {t('blog.backToList')}
    </a>
  </p>
</BaseLayout>
