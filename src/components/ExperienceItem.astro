---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../config';
import { formatRange } from '../i18n/utils';

interface Props { entry: CollectionEntry<'experience'>; lang: Lang; }
const { entry, lang } = Astro.props;
const { company, department, role, start, end } = entry.data;
---

<article class="timeline-entry">
  <div class="entry-content">
    <h3 class="text-lg font-semibold">{company[lang]}</h3>
    <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-subtle">
      <span>{department[lang]}</span><span aria-hidden="true">/</span><span>{role[lang]}</span>
    </p>
  </div>
  <p class="entry-date">{formatRange(start, end, lang)}</p>
</article>