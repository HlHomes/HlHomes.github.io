---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../config';
import { formatRange } from '../i18n/utils';

interface Props { entry: CollectionEntry<'education'>; lang: Lang; }
const { entry, lang } = Astro.props;
const { school, degree, major, start, end } = entry.data;
---

<article class="timeline-entry">
  <div class="entry-content">
    <h3 class="text-lg font-semibold">{school[lang]}</h3>
    <p class="mt-2 text-subtle">{major[lang]} · {degree[lang]}</p>
  </div>
  <p class="entry-date">{formatRange(start, end, lang)}</p>
</article>