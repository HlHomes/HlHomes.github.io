---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../config';
import type { UIKey } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { name, description, tags, year, stars, links, placeholder } = entry.data;

const candidates: ReadonlyArray<[UIKey, string | undefined]> = [
  ['link.repo', links.repo],
  ['link.demo', links.demo],
  ['link.paper', links.paper],
];
const linkEntries = candidates.filter((pair): pair is [UIKey, string] => Boolean(pair[1]));
---

<article
  class="flex flex-col gap-2.5 rounded-lg border border-line bg-surface/50 p-4 transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-[0_12px_28px_-18px_color-mix(in_oklab,var(--color-brand)_60%,transparent)]"
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="font-medium">{name}</h3>
    <div class="flex shrink-0 items-baseline gap-2 text-xs text-subtle">
      {stars !== undefined && <span>★ {stars}</span>}
      {year !== undefined && <span>{year}</span>}
    </div>
  </div>

  <p class="text-sm leading-relaxed text-subtle">{description[lang]}</p>

  {
    placeholder && (
      <p>
        <span class="rounded bg-brand-soft px-1.5 py-px text-xs text-brand">
          {t('meta.placeholder')}
        </span>
      </p>
    )
  }

  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded border border-line px-1.5 py-px text-xs text-subtle">{tag}</li>
        ))}
      </ul>
    )
  }

  {
    linkEntries.length > 0 && (
      <p class="mt-auto flex flex-wrap gap-3 pt-1 text-sm">
        {linkEntries.map(([key, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener"
            class="text-brand underline decoration-brand/30 underline-offset-4 transition-colors hover:decoration-brand"
          >
            {t(key)}
          </a>
        ))}
      </p>
    )
  }
</article>
