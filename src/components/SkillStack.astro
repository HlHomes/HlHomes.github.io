---
import type { Lang } from '../config';
import { SKILLS } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="flex flex-col gap-4">
  {
    SKILLS.map((group) => (
      <div class="flex flex-col gap-2 sm:flex-row sm:gap-5">
        <h3 class="w-28 shrink-0 pt-1 text-xs tracking-[0.15em] text-subtle">
          {group.group[lang]}
        </h3>
        <ul class="flex flex-wrap gap-1.5">
          {group.items.map((item) => (
            <li class="rounded-md border border-line bg-surface px-2 py-0.5 text-xs text-ink/80">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
